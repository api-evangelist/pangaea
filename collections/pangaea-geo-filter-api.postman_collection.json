  "item": [
    {
      "id": "d52167e1-99d3-41cc-bcce-93dc94c09a70",
      "name": "Geo Filter",
      "description": {
        "content": "Filter cross-dataset data by geographic and temporal constraints",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "0fae4947-c7db-47f8-bea7-a206fe2e31b2",
          "name": "Query Data by Geographic Parameters",
          "request": {
            "name": "Query Data by Geographic Parameters",
            "description": {
              "content": "Retrieve geoscientific measurements across multiple datasets filtered by geographic bounding box, temporal range, depth constraints, and PANGAEA parameter IDs. Ideal for extracting cross-dataset measurements from specific ocean regions, time periods, or depth intervals.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dds-fgp",
                "rest",
                "dwhquery"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "westBoundLon",
                  "value": "<float>",
                  "description": "(Required) Western boundary longitude in decimal degrees (-180 to 180)"
                },
                {
                  "disabled": false,
                  "key": "southBoundLat",
                  "value": "<float>",
                  "description": "(Required) Southern boundary latitude in decimal degrees (-90 to 90)"
                },
                {
                  "disabled": false,
                  "key": "eastBoundLon",
                  "value": "<float>",
                  "description": "(Required) Eastern boundary longitude in decimal degrees (-180 to 180)"
                },
                {
                  "disabled": false,
                  "key": "northBoundLat",
                  "value": "<float>",
                  "description": "(Required) Northern boundary latitude in decimal degrees (-90 to 90)"
                },
                {
                  "disabled": false,
                  "key": "pangaeaParameterIDs",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of internal PANGAEA parameter IDs to retrieve. Parameter IDs can be found via the PANGAEA Term Dictionary API.\n"
                },
                {
                  "disabled": false,
                  "key": "dateTimeMin",
                  "value": "<dateTime>",
                  "description": "Start date/time filter in ISO 8601 format"
                },
                {
                  "disabled": false,
                  "key": "dateTimeMax",
                  "value": "<dateTime>",
                  "description": "End date/time filter in ISO 8601 format"
                },
                {
                  "disabled": false,
                  "key": "depthMin",
                  "value": "<float>",
                  "description": "Minimum water depth in meters (below sea surface)"
                },
                {
                  "disabled": false,
                  "key": "depthMax",
                  "value": "<float>",
                  "description": "Maximum water depth in meters (below sea surface)"
                },
                {
                  "disabled": false,
                  "key": "depthMinSed",
                  "value": "<float>",
                  "description": "Minimum sediment/rock depth in meters below seafloor"
                },
                {
                  "disabled": false,
                  "key": "depthMaxSed",
                  "value": "<float>",
                  "description": "Maximum sediment/rock depth in meters below seafloor"
                },
                {
                  "disabled": false,
                  "key": "projectID",
                  "value": "<integer>",
                  "description": "Internal PANGAEA project identifier to filter results"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/tab-separated-values"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "1375eeb0-9370-40af-9e46-0834ef5ea027",
              "name": "Tab-delimited cross-dataset measurements",
