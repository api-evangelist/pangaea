  "item": [
    {
      "id": "38ccb45e-a17f-40ad-941b-bf37f0cc6d45",
      "name": "DOI Filter",
      "description": {
        "content": "Filter dataset data by DOI and parameter values",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "22d2e630-b93f-4b70-8fc8-3ebd56a181d2",
          "name": "Query Dataset by DOI",
          "request": {
            "name": "Query Dataset by DOI",
            "description": {
              "content": "Retrieve tabular dataset data filtered by dataset DOI and optional parameter values. Supports column selection, value filtering with range queries, and multiple filter criteria with AND/OR logic. Returns tab-delimited data files.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dds-fdp",
                "rest",
                "panquery"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "datasetDOI",
                  "value": "<string>",
                  "description": "(Required) DOI of the PANGAEA dataset to retrieve. When used alone, returns the entire dataset. Can be the full DOI URI or just the suffix.\n"
                },
                {
                  "disabled": false,
                  "key": "columns",
                  "value": "<string>",
                  "description": "Comma-delimited list of column numbers to include in the response (no spaces). If omitted, all columns are returned.\n"
                },
                {
                  "disabled": false,
                  "key": "filterParameterValue",
                  "value": "<string>",
                  "description": "Filter rows by parameter value. Format is \"column:value\" or \"column:>value\" or \"column:<value\". Multiple filters use AND logic; multiple values within a filter use OR logic. Can be repeated.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/tab-separated-values"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "9b305ff2-9ad1-4e4c-9a61-06c3b755d11f",
              "name": "Tab-delimited dataset data",
              "originalRequest": {
                "url": {
                  "path": [
                    "dds-fdp",
                    "rest",
                    "panquery"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
